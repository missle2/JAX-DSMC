package kokkos
# SPARTA bench/in.free, unchanged except: the seed and the timed (last) run's length are
# index variables with the original values as defaults (-v seed N, -v steps N), as SPARTA's
# own *.gpu.steps decks parametrise the run length.  `-v reorder N` sets global particle/reorder
# (default 0: off, SPARTA's default) -- a tuning variant, never in headline runs.
# advect particles via free molecular flow on a uniform grid
# particles reflect off global box boundaries

variable            x index 10
variable            y index 10
variable            z index 10

variable            lx equal $x*1.0e-5
variable            lx equal 125*1.0e-5
variable            ly equal $y*1.0e-5
variable            ly equal 160*1.0e-5
variable            lz equal $z*1.0e-5
variable            lz equal 160*1.0e-5

variable            n equal 10*$x*$y*$z
variable            n equal 10*125*$y*$z
variable            n equal 10*125*160*$z
variable            n equal 10*125*160*160

variable            seed index 12345
variable            steps index 100
seed                ${seed}
seed                12345
variable            reorder index 0
global              particle/reorder ${reorder}
global              particle/reorder 0
dimension   	    3
global              gridcut 1.0e-5

boundary	    rr rr rr

create_box  	    0 ${lx} 0 ${ly} 0 ${lz}
create_box  	    0 0.00125 0 ${ly} 0 ${lz}
create_box  	    0 0.00125 0 0.0016 0 ${lz}
create_box  	    0 0.00125 0 0.0016 0 0.0016
Created orthogonal box = (0 0 0) to (0.00125 0.0016 0.0016)
create_grid 	    $x $y $z
create_grid 	    125 $y $z
create_grid 	    125 160 $z
create_grid 	    125 160 160
WARNING: Could not acquire nearby ghost cells b/c grid partition is not clumped (/pscratch/sd/a/aajain/sparta-scaling/src/sparta/src/grid.cpp:486)
Created 3200000 child grid cells
  CPU time = 0.0157638 secs
  create/ghost percent = 86.5685 13.4315

balance_grid        rcb part
Balance grid migrated 3100520 cells
  CPU time = 0.121182 secs
  reassign/sort/migrate/ghost percent = 27.231 0.937335 33.2006 38.6311

species		    ar.species Ar
mixture		    air Ar vstream 0.0 0.0 0.0 temp 273.15

global              nrho 7.07043E22
global              fnum 7.07043E6

create_particles    air n $n
create_particles    air n 32000000
Created 32000000 particles
  CPU time = 0.435859 secs

stats		    10
compute             temp temp
stats_style	    step cpu np nattempt ncoll c_temp

# equilibrate with large timestep to unsort particles
# then benchmark with normal timestep

timestep 	    7.00E-8
run                 30

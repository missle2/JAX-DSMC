package kokkos
# SPARTA bench/in.sphere, unchanged except: the seed and the timed (last) run's length are
# index variables with the original values as defaults (-v seed N, -v steps N), as SPARTA's
# own *.gpu.steps decks parametrise the run length.  `-v reorder N` sets global particle/reorder
# (default 0: off, SPARTA's default) -- a tuning variant, never in headline runs.
# flow around a sphere on a uniform grid
# particles are created initially and input at boundaries at stream velocity

variable            x index 10
variable            y index 10
variable            z index 10

variable            n equal 10*$x*$y*$z
variable            n equal 10*100*$y*$z
variable            n equal 10*100*128*$z
variable            n equal 10*100*128*128
variable            fnum equal 7.33e+21/v_n

variable            seed index 12345
variable            steps index 1000
seed                ${seed}
seed                12346
variable            reorder index 0
global              particle/reorder ${reorder}
global              particle/reorder 0
dimension   	    3
global              nrho 7.03E18
global              fnum ${fnum}
global              fnum 447387695312500
timestep 	    1.E-5
global              gridcut 0.1
global              surfmax 300

boundary	    o o o
create_box          -5.0 5.0 -5.0 5.0 -5.0 5.0
Created orthogonal box = (-5 -5 -5) to (5 5 5)
create_grid         $x $y $z
create_grid         100 $y $z
create_grid         100 128 $z
create_grid         100 128 128
Created 1638400 child grid cells
  CPU time = 0.591857 secs
  create/ghost percent = 35.1317 64.8683

balance_grid        rcb cell
Balance grid migrated 0 cells
  CPU time = 0.235413 secs
  reassign/sort/migrate/ghost percent = 22.638 3.06721 15.5021 58.7927

species		    ar.species Ar

mixture             air Ar frac 1.0
mixture 	    air group species
mixture             air Ar vstream 2500.0 0.0 0.0 temp 300.00

fix		    in emit/face air all

collide		    vss air ar.vss

read_surf	    data.sphere
  1200 triangles
  -1 1 xlo xhi
  -1 1 ylo yhi
  -1 1 zlo zhi
  0.100631 min triangle edge length
  0.00439601 min triangle area

package kokkos
# SPARTA bench/in.collide, unchanged except: the seed and the timed (last) run's length are
# index variables with the original values as defaults (-v seed N, -v steps N), as SPARTA's
# own *.gpu.steps decks parametrise the run length.  `-v reorder N` sets global particle/reorder
# (default 0: off, SPARTA's default) -- a tuning variant, never in headline runs.
# advect particles via VSS collisional flow on a uniform grid
# particles reflect off global box boundaries

variable            x index 10
variable            y index 10
variable            z index 10

variable            lx equal $x*1.0e-5
variable            lx equal 256*1.0e-5
variable            ly equal $y*1.0e-5
variable            ly equal 320*1.0e-5
variable            lz equal $z*1.0e-5
variable            lz equal 320*1.0e-5

variable            n equal 10*$x*$y*$z
variable            n equal 10*256*$y*$z
variable            n equal 10*256*320*$z
variable            n equal 10*256*320*320

variable            seed index 12345
variable            steps index 100
seed                ${seed}
seed                12345
variable            reorder index 0
global              particle/reorder ${reorder}
global              particle/reorder 0
dimension   	    3
global              gridcut 1.0e-5

boundary	    rr rr rr

create_box  	    0 ${lx} 0 ${ly} 0 ${lz}
create_box  	    0 0.00256 0 ${ly} 0 ${lz}
create_box  	    0 0.00256 0 0.0032 0 ${lz}
create_box  	    0 0.00256 0 0.0032 0 0.0032
Created orthogonal box = (0 0 0) to (0.00256 0.0032 0.0032)
create_grid 	    $x $y $z
create_grid 	    256 $y $z
create_grid 	    256 320 $z
create_grid 	    256 320 320

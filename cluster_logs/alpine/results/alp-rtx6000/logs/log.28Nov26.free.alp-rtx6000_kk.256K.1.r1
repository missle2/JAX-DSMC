package kokkos
# SPARTA bench/in.free, unchanged except: the seed and the timed (last) run's length are
# index variables with the original values as defaults (-v seed N, -v steps N), as SPARTA's
# own *.gpu.steps decks parametrise the run length.  `-v reorder N` sets global particle/reorder
# (default 0: off, SPARTA's default).  `-v statsevery N` sets the stats period (default: the
# deck's).  GPU runs use SPARTA's own GPU protocol (bench/in.*.gpu.steps of sparta.github.io:
# stats 100, particle/reorder 10 for collide and sphere) -- see bench/matrix.py GPU_PROTOCOL.
# advect particles via free molecular flow on a uniform grid
# particles reflect off global box boundaries

variable            x index 10
variable            y index 10
variable            z index 10

variable            lx equal $x*1.0e-5
variable            lx equal 25*1.0e-5
variable            ly equal $y*1.0e-5
variable            ly equal 32*1.0e-5
variable            lz equal $z*1.0e-5
variable            lz equal 32*1.0e-5

variable            n equal 10*$x*$y*$z
variable            n equal 10*25*$y*$z
variable            n equal 10*25*32*$z
variable            n equal 10*25*32*32

variable            seed index 12345
variable            steps index 100
seed                ${seed}
seed                12346
variable            reorder index 0
global              particle/reorder ${reorder}
global              particle/reorder 10
dimension   	    3
global              gridcut 1.0e-5

boundary	    rr rr rr

create_box  	    0 ${lx} 0 ${ly} 0 ${lz}
create_box  	    0 0.00025 0 ${ly} 0 ${lz}
create_box  	    0 0.00025 0 0.00032 0 ${lz}
create_box  	    0 0.00025 0 0.00032 0 0.00032
Created orthogonal box = (0 0 0) to (0.00025 0.00032 0.00032)
create_grid 	    $x $y $z
create_grid 	    25 $y $z
create_grid 	    25 32 $z
create_grid 	    25 32 32
Created 25600 child grid cells
  CPU time = 0.00445408 secs
  create/ghost percent = 50.1755 49.8245

balance_grid        rcb part
Balance grid migrated 0 cells
  CPU time = 0.00171763 secs
  reassign/sort/migrate/ghost percent = 22.5638 0.942109 8.42548 68.0686

species		    ar.species Ar
mixture		    air Ar vstream 0.0 0.0 0.0 temp 273.15

global              nrho 7.07043E22
global              fnum 7.07043E6

create_particles    air n $n
create_particles    air n 256000
Created 256000 particles
  CPU time = 0.0521064 secs

variable            statsevery index 10
stats		    ${statsevery}
stats		    100
compute             temp temp
stats_style	    step cpu np nattempt ncoll c_temp

# equilibrate with large timestep to unsort particles
# then benchmark with normal timestep

timestep 	    7.00E-8
run                 30

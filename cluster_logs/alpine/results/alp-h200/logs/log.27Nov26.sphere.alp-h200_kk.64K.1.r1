package kokkos
# SPARTA bench/in.sphere, unchanged except: the seed and the timed (last) run's length are
# index variables with the original values as defaults (-v seed N, -v steps N), as SPARTA's
# own *.gpu.steps decks parametrise the run length.  `-v reorder N` sets global particle/reorder
# (default 0: off, SPARTA's default) -- a tuning variant, never in headline runs.
# flow around a sphere on a uniform grid
# particles are created initially and input at boundaries at stream velocity

variable            x index 10
variable            y index 10
variable            z index 10

variable            n equal 10*$x*$y*$z
variable            n equal 10*16*$y*$z
variable            n equal 10*16*20*$z
variable            n equal 10*16*20*20
variable            fnum equal 7.33e+21/v_n

variable            seed index 12345
variable            steps index 1000
seed                ${seed}
seed                12346
variable            reorder index 0
global              particle/reorder ${reorder}
global              particle/reorder 0
dimension   	    3
global              nrho 7.03E18
global              fnum ${fnum}
global              fnum 1.1453125e+17
timestep 	    1.E-5
global              gridcut 0.1
global              surfmax 300

boundary	    o o o
create_box          -5.0 5.0 -5.0 5.0 -5.0 5.0
Created orthogonal box = (-5 -5 -5) to (5 5 5)
create_grid         $x $y $z
create_grid         16 $y $z
create_grid         16 20 $z
create_grid         16 20 20
Created 6400 child grid cells
  CPU time = 0.000713113 secs
  create/ghost percent = 21.5158 78.4842

balance_grid        rcb cell
Balance grid migrated 0 cells
  CPU time = 0.000523281 secs
  reassign/sort/migrate/ghost percent = 36.4494 0.857283 8.40294 54.2903

species		    ar.species Ar

mixture             air Ar frac 1.0
mixture 	    air group species
mixture             air Ar vstream 2500.0 0.0 0.0 temp 300.00

fix		    in emit/face air all

collide		    vss air ar.vss

read_surf	    data.sphere
  1200 triangles
  -1 1 xlo xhi
  -1 1 ylo yhi
  -1 1 zlo zhi
  0.100631 min triangle edge length
  0.00439601 min triangle area
  72 0 = cells overlapping surfs, overlap cells with unmarked corner pts
  80 tiny edges removed
  6320 8 72 = cells outside/inside/overlapping surfs
  72 = surf cells with 1,2,etc splits
  995.862 995.862 = cell-wise and global flow volume
  CPU time = 0.0134213 secs
  read/check/sort/surf2grid/ghost/inout/particle percent = 7.93766 2.79128 0.392674 22.1981 66.6803 1.30823 0.00044705
  surf2grid time = 0.00297928 secs
  map/comm1/comm2/comm3/comm4/split percent = 12.6211 3.02872 5.68709 0.789521 3.24183 71.7787
surf_collide	    1 diffuse 300.0 1.0
surf_modify         all collide 1

create_particles    air n 0
Created 61126 particles
  CPU time = 0.0106402 secs

fix                 3 balance 100 1.1 rcb part
collide_modify      vremax 100 yes

#compute             1 grid all all nrho mass u v w
#fix                 1 ave/grid all 10 100 1000 c_1[*] ave running
#dump                1 grid all 1000 tmp_flow.* id xc yc zc f_1[*]

#compute             2 surf all all press ke
#fix		    2 ave/surf all 10 100 1000 c_2[*] ave running
#dump                2 surf all 1000 tmp_surf.* id f_2[*]

compute             g grid all all n
compute             max reduce max c_g[1]

stats_style	    step cpu np nattempt ncoll nscoll c_max
stats		    100

# equilibrate flow for 1000 steps
# then benchmark for 1000 steps

run 		    1000

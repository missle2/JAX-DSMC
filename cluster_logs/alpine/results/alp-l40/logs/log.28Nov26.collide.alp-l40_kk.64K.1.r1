package kokkos
# SPARTA bench/in.collide, unchanged except: the seed and the timed (last) run's length are
# index variables with the original values as defaults (-v seed N, -v steps N), as SPARTA's
# own *.gpu.steps decks parametrise the run length.  `-v reorder N` sets global particle/reorder
# (default 0: off, SPARTA's default) -- a tuning variant, never in headline runs.
# advect particles via VSS collisional flow on a uniform grid
# particles reflect off global box boundaries

variable            x index 10
variable            y index 10
variable            z index 10

variable            lx equal $x*1.0e-5
variable            lx equal 16*1.0e-5
variable            ly equal $y*1.0e-5
variable            ly equal 20*1.0e-5
variable            lz equal $z*1.0e-5
variable            lz equal 20*1.0e-5

variable            n equal 10*$x*$y*$z
variable            n equal 10*16*$y*$z
variable            n equal 10*16*20*$z
variable            n equal 10*16*20*20

variable            seed index 12345
variable            steps index 100
seed                ${seed}
seed                12346
variable            reorder index 0
global              particle/reorder ${reorder}
global              particle/reorder 0
dimension   	    3
global              gridcut 1.0e-5

boundary	    rr rr rr

create_box  	    0 ${lx} 0 ${ly} 0 ${lz}
create_box  	    0 0.00016 0 ${ly} 0 ${lz}
create_box  	    0 0.00016 0 0.0002 0 ${lz}
create_box  	    0 0.00016 0 0.0002 0 0.0002
Created orthogonal box = (0 0 0) to (0.00016 0.0002 0.0002)
create_grid 	    $x $y $z
create_grid 	    16 $y $z
create_grid 	    16 20 $z
create_grid 	    16 20 20
Created 6400 child grid cells
  CPU time = 0.00108073 secs
  create/ghost percent = 19.4843 80.5157

balance_grid        rcb part
Balance grid migrated 0 cells
  CPU time = 0.000686685 secs
  reassign/sort/migrate/ghost percent = 29.7294 1.24089 9.44873 59.581

species		    ar.species Ar
mixture		    air Ar vstream 0.0 0.0 0.0 temp 273.15

global              nrho 7.07043E22
global              fnum 7.07043E6

collide		    vss air ar.vss

create_particles    air n $n
create_particles    air n 64000
Created 64000 particles
  CPU time = 0.0199587 secs

stats		    10
compute             temp temp
stats_style	    step cpu np nattempt ncoll c_temp

# first equilibrate with large timestep to unsort particles
# then benchmark with normal timestep

timestep 	    7.00E-8
run                 30

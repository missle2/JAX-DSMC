  surf2grid time = 1.24536 secs
  map/comm1/comm2/comm3/comm4/split percent = 32.1422 0.0234856 39.5893 4.02508 7.49433 9.23582
surf_collide	    1 diffuse 300.0 1.0
surf_modify         all collide 1

create_particles    air n 0

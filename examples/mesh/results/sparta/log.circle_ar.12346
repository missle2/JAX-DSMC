SPARTA (24 Sep 2025)
Running on 1 MPI task(s)
################################################################################
# 2d flow around a circle -- single-species argon variant of
# sparta/examples/circle/in.circle (same grid, density, fnum, timestep, walls).
#
# Run:  spa_serial -var seed 12345 -in in.circle_ar -log log.circle_ar.12345
#
# The "comm/sort" and "twopass" options make runs reproducible (they match
# MPI/Kokkos runs) and are kept from the shipped input.
################################################################################

seed	    	    ${seed}
seed	    	    12346
dimension   	    2
global              gridcut 0.0 comm/sort yes

boundary	    o r p

create_box  	    0 10 0 10 -0.5 0.5
Created orthogonal box = (0 0 -0.5) to (10 10 0.5)
create_grid 	    20 20 1
Created 400 child grid cells
  CPU time = 0.000550032 secs
  create/ghost percent = 85.7824 14.2176
balance_grid        rcb cell
Balance grid migrated 0 cells
  CPU time = 4.50611e-05 secs
  reassign/sort/migrate/ghost percent = 33.3333 2.1164 29.1005 35.4497

global		    nrho 1.0 fnum 0.001

species		    ar.species Ar
mixture		    ar Ar vstream 100.0 0 0

read_surf           data.circle
  50 lines
  2 8 xlo xhi
  2.00592 7.99408 ylo yhi
  0 0 zlo zhi
  0.376743 min line length
  48 0 = cells overlapping surfs, overlap cells with unmarked corner pts
  264 88 48 = cells outside/inside/overlapping surfs
  48 = surf cells with 1,2,etc splits
  71.8 71.8 = cell-wise and global flow volume
  CPU time = 0.000262976 secs
  read/check/sort/surf2grid/ghost/inout/particle percent = 11.786 17.0444 1.9039 61.2874 7.97824 7.16228 0
  surf2grid time = 0.000161171 secs
  map/comm1/comm2/comm3/comm4/split percent = 39.7929 6.80473 15.5325 6.06509 16.716 9.91124
surf_collide	    1 diffuse 300.0 0.0
surf_modify         all collide 1

collide             vss ar ar.vss

fix		    in emit/face ar xlo twopass

timestep 	    0.0001

# (a) per-cell geometry and flow volume (area in 2d), written once at step 0
compute             vol property/grid all id xc yc vol
dump                gvol grid all 1000 grid_vol.circle_ar.${seed}.txt id xc yc vol
dump                gvol grid all 1000 grid_vol.circle_ar.12346.txt id xc yc vol
dump_modify         gvol first yes

# (b) surface loads averaged over the last 300 steps (2d: "area" = line length)
compute             s surf all all n press px py pz shx shy shz fx fy fz ke
fix                 as ave/surf all 1 300 1000 c_s[*] ave one
dump                dsurf surf all 1000 surf_ave.circle_ar.${seed}.txt                     id v1x v1y v2x v2y area f_as[*]
dump                dsurf surf all 1000 surf_ave.circle_ar.12346.txt                     id v1x v1y v2x v2y area f_as[*]

# (c) cell fields averaged over the last 300 steps
compute             g grid all all n nrho u v w temp
fix                 ag ave/grid all 1 300 1000 c_g[*] ave one
dump                dgrid grid all 1000 grid_ave.circle_ar.${seed}.txt                     id xc yc f_ag[*]
dump                dgrid grid all 1000 grid_ave.circle_ar.12346.txt                     id xc yc f_ag[*]

# (d) fill curves every 10 steps
stats		    10
stats_style	    step cpu np nattempt ncoll nscoll nscheck nexit nbound
run 		    1000

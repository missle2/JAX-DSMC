Running on 1 MPI task(s)
################################################################################
# 3d flow around a sphere -- single-species argon variant of
# sparta/examples/sphere/in.sphere (same grid, density, fnum, timestep, walls).
#
# Run:  spa_serial -var seed 12345 -in in.sphere_ar -log log.sphere_ar.12345
#
# The "comm/sort" and "twopass" options make runs reproducible (they match
# MPI/Kokkos runs) and are kept from the shipped input.
################################################################################

seed	    	    ${seed}
seed	    	    12348
dimension   	    3

global              gridcut 0.1 comm/sort yes

boundary	    o r r

create_box  	    -2 2 -2 2 -2 2
Created orthogonal box = (-2 -2 -2) to (2 2 2)

create_grid         20 20 20
Created 8000 child grid cells
  CPU time = 0.00175381 secs
  create/ghost percent = 38.5943 61.4057

balance_grid        rcb cell
Balance grid migrated 0 cells
  CPU time = 0.000825882 secs
  reassign/sort/migrate/ghost percent = 35.4792 2.77136 10.537 51.2125

global		    nrho 1.0 fnum 0.0005

species		    ar.species Ar
mixture		    ar Ar vstream 100.0 0 0

read_surf           data.sphere
  1200 triangles
  -1 1 xlo xhi
  -1 1 ylo yhi
  -1 1 zlo zhi
  0.100631 min triangle edge length
  0.00439601 min triangle area
  440 0 = cells overlapping surfs, overlap cells with unmarked corner pts
  7256 304 440 = cells outside/inside/overlapping surfs
  440 = surf cells with 1,2,etc splits
  59.8617 59.8617 = cell-wise and global flow volume
  CPU time = 0.0117149 secs
  read/check/sort/surf2grid/ghost/inout/particle percent = 2.85127 4.73584 0.6655 54.7684 36.979 2.43203 0
  surf2grid time = 0.00641608 secs
  map/comm1/comm2/comm3/comm4/split percent = 14.3101 2.99134 4.81587 1.33774 1.79109 72.8327
surf_collide	    1 diffuse 300.0 0.0
surf_modify         all collide 1

collide		    vss ar ar.vss

fix		    in emit/face ar xlo twopass

timestep 	    0.0001

# (a) per-cell geometry and flow volume, written once at step 0
compute             vol property/grid all id xc yc zc vol
dump                gvol grid all 1000 grid_vol.sphere_ar.${seed}.txt id xc yc zc vol
dump                gvol grid all 1000 grid_vol.sphere_ar.12348.txt id xc yc zc vol
dump_modify         gvol first yes

# (b) surface loads averaged over the last 300 steps
compute             s surf all all n press px py pz shx shy shz fx fy fz ke
fix                 as ave/surf all 1 300 1000 c_s[*] ave one
dump                dsurf surf all 1000 surf_ave.sphere_ar.${seed}.txt                     id v1x v1y v1z v2x v2y v2z v3x v3y v3z area f_as[*]
dump                dsurf surf all 1000 surf_ave.sphere_ar.12348.txt                     id v1x v1y v1z v2x v2y v2z v3x v3y v3z area f_as[*]

# (c) cell fields averaged over the last 300 steps
compute             g grid all all n nrho u v w temp
fix                 ag ave/grid all 1 300 1000 c_g[*] ave one
dump                dgrid grid all 1000 grid_ave.sphere_ar.${seed}.txt                     id xc yc zc f_ag[*]
dump                dgrid grid all 1000 grid_ave.sphere_ar.12348.txt                     id xc yc zc f_ag[*]

# (d) fill curves every 10 steps
stats		    10
stats_style	    step cpu np nattempt ncoll nscoll nscheck nexit nbound
run 		    1000
